{
  "description": "Refuse a whole-file Read of a long source file (token-efficient-work rule 1).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/guard-full-read.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
